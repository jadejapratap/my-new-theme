{%- style -%}
  #shopify-section-{{ section.id }} .pt {
    --pt-columns: {{ section.settings.columns_desktop }};
    --pt-gap: {{ section.settings.gap }}px;
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="pt" data-product-tabs>
  {%- if section.settings.heading != blank -%}
    <h2 class="pt__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 1 -%}
    <div class="pt__tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button
          type="button"
          role="tab"
          id="pt-tab-{{ block.id }}"
          class="pt__tab{% if forloop.first %} is-active{% endif %}"
          data-pt-tab="{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="pt-panel-{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          {{- block.settings.label -}}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- liquid
      assign tab_collection = block.settings.collection
      if tab_collection == blank
        assign tab_collection = collections['all']
      endif
      assign is_first = forloop.first
    -%}

    <div
      class="pt__panel"
      id="pt-panel-{{ block.id }}"
      role="tabpanel"
      aria-labelledby="pt-tab-{{ block.id }}"
      data-pt-panel="{{ block.id }}"
      {% unless is_first %}hidden{% endunless %}
      {% if section.blocks.size == 1 %}{{ block.shopify_attributes }}{% endif %}
    >
      <div class="pt__grid">
        {%- for product in tab_collection.products limit: section.settings.products_count -%}
          {%- liquid
            assign on_sale = false
            if product.compare_at_price > product.price
              assign on_sale = true
              assign percent_off = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
            endif
            assign second_image = product.images[1]
          -%}
          <div class="pt__card">
            <a href="{{ product.url }}" class="pt__media" aria-label="{{ product.title | escape }}">
              {%- if on_sale -%}
                <span class="pt__badge">-{{ percent_off }}%</span>
              {%- elsif product.available == false -%}
                <span class="pt__badge pt__badge--muted">{{ 'products.product.sold_out' | t }}</span>
              {%- endif -%}

              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 700
                  | image_tag:
                    widths: '260, 360, 520, 700',
                    sizes: '(min-width: 990px) 20vw, (min-width: 750px) 33vw, 50vw',
                    loading: 'lazy',
                    class: 'pt__image pt__image--main',
                    alt: product.featured_image.alt
                }}
                {%- if second_image != blank and section.settings.hover_image -%}
                  {{
                    second_image
                    | image_url: width: 700
                    | image_tag:
                      widths: '260, 360, 520, 700',
                      sizes: '(min-width: 990px) 20vw, (min-width: 750px) 33vw, 50vw',
                      loading: 'lazy',
                      class: 'pt__image pt__image--hover',
                      alt: ''
                  }}
                {%- endif -%}
              {%- else -%}
                <div class="pt__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {%- endif -%}
            </a>

            <div class="pt__info">
              <a href="{{ product.url }}" class="pt__title">{{ product.title }}</a>
              <div class="pt__price">
                {%- if on_sale -%}
                  <span class="pt__price-now">{{ product.price | money }}</span>
                  <s class="pt__price-was">{{ product.compare_at_price | money }}</s>
                {%- else -%}
                  <span class="pt__price-now">{{ product.price | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- else -%}
          <p class="pt__empty">{{ section.settings.empty_text }}</p>
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% stylesheet %}
  .pt {
    max-width: 1920px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  .pt__heading {
    margin: 0 0 24px;
    text-align: center;
    font-family: var(--font-heading--family, inherit);
    font-weight: 500;
  }

  .pt__tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 40px;
    margin-bottom: 40px;
  }

  .pt__tab {
    padding: 4px 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: rgb(0 0 0 / 0.5);
    font-family: var(--font-heading--family, inherit);
    font-size: 1.25rem;
    line-height: 1.4;
    cursor: pointer;
  }

  .pt__tab:hover,
  .pt__tab.is-active {
    color: #111;
  }

  .pt__tab.is-active {
    border-bottom-color: #111;
  }

  .pt__panel[hidden] {
    display: none;
  }

  .pt__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px var(--pt-gap, 10px);
  }

  .pt__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #efefef;
  }

  .pt__image,
  .pt__placeholder,
  .pt__placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pt__image--hover {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (hover: hover) {
    .pt__media:hover .pt__image--hover {
      opacity: 1;
    }
  }

  .pt__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 4px 8px;
    border-radius: 2px;
    background: #f15a22;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pt__badge--muted {
    background: #111;
  }

  .pt__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 12px;
  }

  .pt__title {
    color: inherit;
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .pt__title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pt__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: 0.9375rem;
  }

  .pt__price-was {
    color: rgb(0 0 0 / 0.5);
    font-size: 0.875rem;
  }

  .pt__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: rgb(0 0 0 / 0.6);
  }

  @media screen and (min-width: 750px) {
    .pt__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .pt {
      padding-inline: 50px;
    }

    .pt__grid {
      grid-template-columns: repeat(var(--pt-columns, 5), 1fr);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function init(root) {
      if (root.dataset.ptReady) return;
      root.dataset.ptReady = 'true';

      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-pt-tab]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-pt-panel]'));
      if (tabs.length < 2) return;

      function select(id) {
        tabs.forEach(function (tab) {
          var active = tab.dataset.ptTab === id;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach(function (panel) {
          panel.hidden = panel.dataset.ptPanel !== id;
        });
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () {
          select(tab.dataset.ptTab);
        });
        tab.addEventListener('keydown', function (event) {
          var next = null;
          if (event.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
          if (event.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
          if (next) {
            event.preventDefault();
            next.focus();
            select(next.dataset.ptTab);
          }
        });
      });

      // In the theme editor, open the tab of the block being edited
      root.addEventListener('shopify:block:select', function (event) {
        var id = event.detail && event.detail.blockId;
        if (id && root.querySelector('[data-pt-tab="' + id + '"]')) select(id);
      });
    }

    function initAll() {
      document.querySelectorAll('[data-product-tabs]').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
    document.addEventListener('shopify:section:load', initAll);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Product tabs",
  "tag": "section",
  "class": "section-product-tabs",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products per tab",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "hover_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when a collection has no products",
      "default": "No products found in this collection."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Best Sellers"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "If empty, all products are shown."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Best Sellers" } },
        { "type": "tab", "settings": { "label": "New Products" } },
        { "type": "tab", "settings": { "label": "Sale Products" } }
      ]
    }
  ]
}
{% endschema %}
