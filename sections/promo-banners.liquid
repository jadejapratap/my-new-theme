{%- style -%}
  #shopify-section-{{ section.id }} .pb {
    --pb-columns: {{ section.settings.columns_desktop }};
    --pb-gap: {{ section.settings.gap }}px;
    --pb-height: {{ section.settings.card_height }}px;
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="pb">
  <div class="pb__grid{% if section.settings.full_width %} pb__grid--full{% endif %}">
    {%- for block in section.blocks -%}
      {%- assign link = block.settings.link -%}
      <div
        class="pb__card"
        style="--pb-bg: {{ block.settings.background_color }}; --pb-text: {{ block.settings.text_color }};"
        {{ block.shopify_attributes }}
      >
        {%- if link != blank -%}
          <a href="{{ link }}" class="pb__link" aria-label="{{ block.settings.heading | strip_newlines | escape }}"></a>
        {%- endif -%}

        <div class="pb__content">
          {%- if block.settings.heading != blank -%}
            <h3 class="pb__heading">{{ block.settings.heading | newline_to_br }}</h3>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <span class="pb__label">{{ block.settings.link_label }}</span>
          {%- endif -%}
        </div>

        <div class="pb__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag:
                widths: '300, 450, 600, 900',
                sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
                loading: 'lazy',
                class: 'pb__image'
            }}
          {%- else -%}
            <div class="pb__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .pb__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pb-gap, 10px);
    max-width: 1920px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  .pb__card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    min-height: var(--pb-height, 290px);
    overflow: hidden;
    background: var(--pb-bg, #ececec);
    color: var(--pb-text, #161616);
  }

  .pb__link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .pb__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 8px;
    padding: 24px 24px 24px 7%;
    max-width: 60%;
  }

  .pb__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(1.5rem, 2.2vw, 2.25rem);
    font-weight: 500;
    line-height: 1.15;
    color: inherit;
  }

  .pb__label {
    font-size: 0.9375rem;
    color: inherit;
  }

  .pb__card:hover .pb__label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pb__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 40%;
    z-index: 1;
  }

  .pb__image,
  .pb__placeholder,
  .pb__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  @media screen and (min-width: 750px) {
    .pb__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .pb__grid {
      grid-template-columns: repeat(var(--pb-columns, 3), 1fr);
      padding-inline: 50px;
    }

    .pb__grid--full {
      padding-inline: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banners",
  "tag": "section",
  "class": "section-promo-banners",
  "max_blocks": 4,
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Banners per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Banner height",
      "min": 180,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 290
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between banners",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Remove side spacing on desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "info": "Press Enter to start a new line.",
          "default": "Women's\nMid-Season"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#e9e9e9"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#161616"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo banners",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}
